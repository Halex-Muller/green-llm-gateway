# Configurações do Servidor
PORT=3000
HOST=0.0.0.0

# Provedor LLM Upstream (Ex: OpenAI, Groq, OpenRouter, etc.)
UPSTREAM_API_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=sua-chave-api-aqui

# Configurações de Cache e Roteamento (Fases futuras)
SEMANTIC_CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.90
MODEL_CASCADING_ENABLED=true
DEFAULT_SLM_MODEL=gpt-3.5-turbo
DEFAULT_FLM_MODEL=gpt-4o
