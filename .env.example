# Configurações do Servidor
PORT=3000
HOST=0.0.0.0

# Provedor LLM Upstream (Configurado para o Google Gemini via endpoint compatível OpenAI)
UPSTREAM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
UPSTREAM_API_KEY=sua-chave-api-aqui

# Configurações de Cache e Roteamento
SEMANTIC_CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.90
MODEL_CASCADING_ENABLED=true
DEFAULT_SLM_MODEL=gemini-1.5-flash
DEFAULT_FLM_MODEL=gemini-2.0-flash
